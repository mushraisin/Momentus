# ШАБЛОН. Скопіюй у .env і заповни реальними значеннями.
# ⚠️ НІКОЛИ не вписуй сюди справжні токени — цей файл потрапляє в git.

# ─────────────────────────────────────────────
#  Discord
# ─────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Гільдія для миттєвої реєстрації контекстних меню (dev). Для глобальних — залиш пустим.
DISCORD_GUILD_ID=
# Секрет застосунку (OAuth2 → вхід на сайті). Developer Portal → OAuth2.
DISCORD_CLIENT_SECRET=

# ─────────────────────────────────────────────
#  Аналітичне ядро (провайдер)
# ─────────────────────────────────────────────
# ЗА ЗАМОВЧУВАННЯМ — БЕЗ ШІ: детермінований правило-рушій (лексикони + regex +
# поведінкові сигнали). Працює офлайн, без ключів, миттєво.
#
#   (порожньо) → правило-рушій без ШІ  ← РЕКОМЕНДОВАНО
#   ollama     → локальна модель (Ollama)
#   anthropic  → хмара Anthropic (потрібен ключ)
AI_PROVIDER=
AI_DISABLED=false

# ── Якщо AI_PROVIDER=ollama ──
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Якщо AI_PROVIDER=anthropic ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low

# ─────────────────────────────────────────────
#  Веб-сайт спільноти
# ─────────────────────────────────────────────
# Публічна адреса (для OAuth redirect), напр. https://site.com
WEB_PUBLIC_URL=
# Порт. На Pterodactyl є готова SERVER_PORT — вона має пріоритет.
WEB_PORT=8080
WEB_DISABLED=false
# Якщо бот на кількох серверах — ID гільдії, яку показує сайт
WEB_GUILD_ID=

# ─────────────────────────────────────────────
#  Cloudflare Tunnel (для scripts/withTunnel.js)
# ─────────────────────────────────────────────
# Варіант 1 — тунель із дашборду Zero Trust:
CLOUDFLARE_TUNNEL_TOKEN=
# Варіант 2 — тунель, створений через `cloudflared tunnel create`:
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS=

# ─────────────────────────────────────────────
#  Сховище
# ─────────────────────────────────────────────
# Turso (хмарний libSQL): turso.tech → create database → Connect
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Локальний файл (якщо TURSO_DATABASE_URL порожній)
DATABASE_PATH=./data/community.db

# ─────────────────────────────────────────────
#  Медіа галереї, варіант 1 (рекомендований): канал-сховище в Discord.
#  Обсяг безлімітний і безкоштовний; ліміт на файл — 10/50/100 МБ за бустами.
#  Зазвичай задається в панелі власника (🎬 Галерея й кінотеатр → Канал-сховище),
#  ця змінна — запасний спосіб.
# ─────────────────────────────────────────────
MEDIA_CHANNEL_ID=

# ─────────────────────────────────────────────
#  Медіа галереї, варіант 2: S3-сумісне сховище (Cloudflare R2, B2, MinIO)
#  Якщо не заповнено — файли лягають у БД (працює, але швидко роздуває Turso).
#  R2: Cloudflare → R2 → Create bucket → Manage API tokens → Object Read & Write
# ─────────────────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Публічний домен бакета (r2.dev або свій) — звідки браузер тягне медіа
S3_PUBLIC_URL=

# ─────────────────────────────────────────────
#  Кінотеатр: витягування прямого відео
#  Дає повну синхронізацію (пауза/перемотка) майже з будь-якого сайту.
#  Бінарник уже лежить у bin/yt-dlp_linux — просто залийте його на хост,
#  бот знайде його сам. Ця змінна потрібна, лише якщо шлях інший.
# ─────────────────────────────────────────────
YTDLP_PATH=
YTDLP_TIMEOUT_MS=12000
# true — не використовувати yt-dlp взагалі (можна й видалити bin/, звільнивши 38 МБ)
YTDLP_DISABLED=
# Ключ підпису для проксі медіа. Порожньо — виводиться з токена бота.
PROXY_SECRET=
BACKUP_DIR=./data/backups
LOG_LEVEL=info

# ─────────────────────────────────────────────
#  Ігри учасників у профілі
# ─────────────────────────────────────────────
# Discord НЕ зберігає «наіграні години» — у його API такого немає, видно лише
# те, у що людина грає прямо зараз. Тому години рахує сам бот: бачить початок
# гри, бачить кінець, додає різницю. Статистика починається з дня, коли це
# увімкнули, — минулого не відновити.
#
# Щоб увімкнути, потрібні ДВІ речі одночасно:
#   1) тут TRACK_GAMES=true
#   2) у Discord Developer Portal → Bot → увімкнути «Presence Intent»
# Без пункту 2 бот із цим наміром просто не підключиться, тож вмикайте свідомо.
TRACK_GAMES=false
